# Dros Math 2026 — Environment Variables
# Copy to .env and fill in values. NEVER commit .env

# ─────────────────────────────────────────────────────────────
# DATABASE (required)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/app_db?sslmode=require"

# ─────────────────────────────────────────────────────────────
# AUTH / SESSIONS (required)
# ─────────────────────────────────────────────────────────────
# 32+ random bytes, base64url. Generate: openssl rand -base64 32
SESSION_SECRET="your-session-secret-here"
SESSION_COOKIE_NAME="dros_session"
SESSION_TTL_DAYS="30"

# ─────────────────────────────────────────────────────────────
# APP (required)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NODE_ENV="production"

# ─────────────────────────────────────────────────────────────
# REDIS (required for rate limiting in production)
# ─────────────────────────────────────────────────────────────
REDIS_URL="redis://user:password@host:6379"

# ─────────────────────────────────────────────────────────────
# PAYMENT PROVIDER (production only)
# ─────────────────────────────────────────────────────────────
# Stripe
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# OR Paymob (Egypt)
PAYMOB_API_KEY="..."
PAYMOB_INTEGRATION_ID="..."
PAYMOB_IFRAME_ID="..."
PAYMOB_HMAC_SECRET="..."

# ─────────────────────────────────────────────────────────────
# FILE STORAGE (production only)
# ─────────────────────────────────────────────────────────────
# S3 / R2 / MinIO
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
S3_BUCKET="dros-math-uploads"
S3_PUBLIC_URL="https://uploads.your-domain.com"

# ─────────────────────────────────────────────────────────────
# EMAIL / NOTIFICATIONS (production only)
# ─────────────────────────────────────────────────────────────
# Resend / SendGrid / Nodemailer SMTP
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_..."
EMAIL_FROM="Dros Math <noreply@your-domain.com>"

# ─────────────────────────────────────────────────────────────
# MONITORING (production only)
# ─────────────────────────────────────────────────────────────
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_ORG="..."
SENTRY_PROJECT="..."

# ─────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────
# Rate limit overrides (requests per window)
RATE_LIMIT_AUTH_WINDOW_MS="900000"      # 15 min
RATE_LIMIT_AUTH_MAX="5"                  # 5 attempts per 15 min
RATE_LIMIT_API_WINDOW_MS="60000"         # 1 min
RATE_LIMIT_API_MAX="100"                 # 100 requests per min
RATE_LIMIT_ENROLL_WINDOW_MS="3600000"    # 1 hour
RATE_LIMIT_ENROLL_MAX="10"               # 10 enrollments per hour